# ==========================================
# STUDYFLOW AI - ENVIRONMENT VARIABLES
# ==========================================
# 💡 VERCEL TIP: If Vercel blocks "VITE_", simply remove it.
# E.g., Use "PUBLIC_CLERK_PUBLISHABLE_KEY" or "CLERK_PUBLISHABLE_KEY" 
# ==========================================

# 1. Clerk Authentication
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY

# 2. Supabase Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJh...YOUR_SUPABASE_SERVICE_ROLE_KEY

# 3. AI Providers
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
SECONDARY_AI_BASE_URL=https://api.groq.com/openai/v1

# 4. Groq Fallback Pool (Comma-separated list of extra Groq keys for rate limits)
FALLBACK_API_KEYS=gsk_KEY1,gsk_KEY2,gsk_KEY3

# 5. Security & Admin
ADMIN_SECRET=YOUR_SECURE_ADMIN_PASSWORD_HERE
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# 6. Optional Configuration
PORT=3000
NODE_ENV=production
