# ==========================================
# STUDYFLOW AI - ENVIRONMENT VARIABLES
# ==========================================
# This file exactly matches the variables read in server/config/env.ts
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# The port the server will run on
PORT=3000
# The environment the app is running in (development/production)
NODE_ENV=development
# The public URL of the application
APP_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# The URL of your Supabase project
SUPABASE_URL=https://your-project-id.supabase.co
# The public anonymous key for Supabase
SUPABASE_ANON_KEY=eyJh...YOUR_SUPABASE_ANON_KEY
# The service role key for Supabase (keep this secure!)
SUPABASE_SERVICE_ROLE_KEY=eyJh...YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------
# Legacy AI Configuration
# ------------------------------------------
# The primary AI API key (e.g., OpenAI or Groq)
PRIMARY_AI_API_KEY=your_primary_ai_api_key
# The base URL for the primary AI API (default: https://api.openai.com/v1)
PRIMARY_AI_BASE_URL=https://api.openai.com/v1
# The model used for primary tasks (default: gpt-4o-mini)
PRIMARY_AI_MODEL=gpt-4o-mini
# The secondary AI API key
SECONDARY_AI_API_KEY=your_secondary_ai_api_key
# The base URL for the secondary AI API (default: https://api.openai.com/v1)
SECONDARY_AI_BASE_URL=https://api.openai.com/v1
# The model used for secondary tasks (default: gpt-3.5-turbo)
SECONDARY_AI_MODEL=gpt-3.5-turbo

# ------------------------------------------
# Stage-Specific Legacy AI Overrides
# ------------------------------------------
# AI API key for the Solver stage
SOLVER_AI_API_KEY=your_solver_api_key
# Base URL for the Solver AI API
SOLVER_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model for the Solver stage
SOLVER_AI_MODEL=gemini-1.5-flash
# AI API key for the Critic stage
CRITIC_AI_API_KEY=your_critic_api_key
# Base URL for the Critic AI API
CRITIC_AI_BASE_URL=https://openrouter.ai/api/v1
# Model for the Critic stage
CRITIC_AI_MODEL=anthropic/claude-3-haiku
# Model for Vision (Image) tasks
VISION_AI_MODEL=gpt-4o
# Model for multilingual tasks (Hindi/Bengali)
MULTILINGUAL_AI_MODEL=gpt-4o-mini

# ------------------------------------------
# New AI Architecture Configuration
# ------------------------------------------
# Enable the new per-stage AI architecture (true/false)
USE_NEW_AI_ARCHITECTURE=true
# Provider for the Router stage (e.g., groq)
ROUTER_PROVIDER=groq
# Model for the Router stage
ROUTER_MODEL=llama-3.1-8b-instant
# Provider for the Conversation stage
CONVERSATION_PROVIDER=groq
# Model for the Conversation stage
CONVERSATION_MODEL=llama-3.1-70b-versatile
# Provider for the Solver stage
SOLVER_PROVIDER=openrouter
# Model for the Solver stage
SOLVER_MODEL=google/gemini-1.5-flash
# Provider for the Critic stage
CRITIC_PROVIDER=openrouter
# Model for the Critic stage
CRITIC_MODEL=deepseek/deepseek-chat

# ------------------------------------------
# Provider-Specific APIs
# ------------------------------------------
# API Key for Groq
GROQ_API_KEY=your_groq_api_key
# Base URL for Groq API
GROQ_BASE_URL=https://api.groq.com/openai/v1
# API Key for OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
# Base URL for OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------
# Groq Fallback Keys
# ------------------------------------------
# Fallback API keys for Groq rate limits
GROQ_FALLBACK_KEY_1=your_fallback_key_1
GROQ_FALLBACK_KEY_2=your_fallback_key_2
GROQ_FALLBACK_KEY_3=your_fallback_key_3
GROQ_FALLBACK_KEY_4=your_fallback_key_4
GROQ_FALLBACK_KEY_5=your_fallback_key_5
GROQ_FALLBACK_KEY_6=your_fallback_key_6
GROQ_FALLBACK_KEY_7=your_fallback_key_7
GROQ_FALLBACK_KEY_8=your_fallback_key_8
GROQ_FALLBACK_KEY_9=your_fallback_key_9
GROQ_FALLBACK_KEY_10=your_fallback_key_10

# ------------------------------------------
# Admin & Security
# ------------------------------------------
# Secret password for admin operations
ADMIN_SECRET=your_admin_secret_password

# ------------------------------------------
# Payment Integration
# ------------------------------------------

